{
  "name": "@hedystia/discord",
  "version": "2.1.0",
  "description": "A modern, type-safe Discord client library for Bun and Node.js",
  "scripts": {
    "build": "tsdown --config-loader unrun",
    "release:pkg": "bun publish --provenance --access public",
    "dev": "tsdown --watch",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "bun test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hedystia/Client.git"
  },
  "author": {
    "name": "Zastinian",
    "email": "contact@zastinian.com",
    "url": "https://github.com/Zastinian"
  },
  "type": "commonjs",
  "types": "./dist/index.d.cts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.cts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@types/bun": "1.3.14",
    "@types/ws": "8.18.1",
    "tsdown": "0.22.14"
  },
  "dependencies": {
    "@snazzah/davey": "0.1.12",
    "discord-api-types": "^0.38.53",
    "opusscript": "0.1.1",
    "ws": "^8.20.0"
  },
  "bugs": {
    "url": "https://github.com/Hedystia/Client/issues"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/Hedystia/Client",
  "keywords": [
    "discord",
    "api",
    "client",
    "typescript",
    "websocket",
    "ws",
    "bun"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
